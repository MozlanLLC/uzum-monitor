{
  "manifest_version": 3,
  "name": "Uzum Монитор цен",
  "short_name": "Uzum Монитор",
  "description": "Следит за ценой, наличием и количеством товаров на uzum.uz и сообщает об изменениях.",
  "version": "1.0.0",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Uzum Монитор цен",
    "default_popup": "ui.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "storage",
    "unlimitedStorage",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://uzum.uz/*",
    "https://www.uzum.uz/*"
  ]
}
